# ==========================================
# CONFIGURAÇÕES DE PRODUÇÃO - HOSTINGER
# Copie este conteúdo para o arquivo .env no servidor
# ==========================================

APP_NAME="TRUE Eventos"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seudominio.com.br

# IPs de proxy/CDN confiáveis (deixe vazio se não usar Cloudflare ou proxy)
TRUSTED_PROXIES=

# ==========================================
# BANCO DE DADOS (MySQL Hostinger)
# Preencha com os dados criados no hPanel -> Bancos de Dados MySQL
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_nomedobanco
DB_USERNAME=u123456789_usuariobanco
DB_PASSWORD=SuaSenhaForteAqui

# ==========================================
# SESSÃO
# ==========================================
SESSION_NAME=true_app_session
SESSION_LIFETIME=120

# ==========================================
# E-MAIL (Mailgun para Produção ou Native)
# ==========================================
MAIL_DRIVER=mailgun
MAIL_FROM=contato@trueeventos.com.br
MAIL_FROM_NAME="TRUE Eventos"
MAIL_ADMIN_NOTIFY=alquimiaeventosdf@hotmail.com

# Dados do Mailgun (obrigatório se MAIL_DRIVER=mailgun)
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.trueeventos.com.br
MAILGUN_REGION=us

# ==========================================
# WHATSAPP NOTIFICAÇÕES
# ==========================================
WHATSAPP_NUMBER=5561998448371
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ==========================================
# STRIPE (Chaves de Produção ou Teste)
# ==========================================
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ==========================================
# RATE LIMIT
# ==========================================
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_DECAY_MINUTES=15
