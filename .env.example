# ==========================================
# APP
# ==========================================
APP_NAME="Projeto Base"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# IPs de proxy/CDN confiáveis (separados por vírgula), ex: Cloudflare, load
# balancer da Hostinger. Só requisições vindas desses IPs terão o header
# X-Forwarded-For respeitado por Request::ip() — deixe vazio se a app
# recebe tráfego direto (sem proxy na frente).
TRUSTED_PROXIES=

# ==========================================
# DATABASE (PDO / MySQL)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=projeto_base
DB_USERNAME=root
DB_PASSWORD=

# ==========================================
# SESSION
# ==========================================
SESSION_NAME=app_session
SESSION_LIFETIME=120

# ==========================================
# MAIL
# ==========================================
# Driver: "mailgun" (produção) ou "native" (desenvolvimento/fallback)
MAIL_DRIVER=native
MAIL_FROM=contato@trueeventos.com.br
MAIL_FROM_NAME="True Eventos"
MAIL_ADMIN_NOTIFY=alquimiaeventosdf@hotmail.com

# Mailgun (necessário quando MAIL_DRIVER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.trueeventos.com.br
MAILGUN_REGION=us

# ==========================================
# WHATSAPP NOTIFICAÇÕES
# ==========================================
WHATSAPP_NUMBER=5561998448371
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ==========================================
# STRIPE
# ==========================================
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==========================================
# RATE LIMIT
# ==========================================
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_DECAY_MINUTES=15
